# Optional: only needed when the frontend and Node server use separate hosts.
# Set this BEFORE npm run build; Vite embeds it in the frontend.
# VITE_PRESENCE_URL=https://your-node-server.example.com
# Server-only configuration (set via hosting dashboard / environment):
# PORT=3000
# HOST=0.0.0.0
# ALLOWED_ORIGINS=https://your-portfolio.example.com
